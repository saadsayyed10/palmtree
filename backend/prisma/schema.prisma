generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id           String   @id
  name         String
  email        String
  role         UserType
  password     String
  contact      String
  address      String
  aadharNumber String
  panNumber    String
  createdAt    DateTime @default(now())
}

enum UserType {
  FOUNDER
}
