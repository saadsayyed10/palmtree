generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id              String   @id
  name            String
  email           String   @unique
  role            UserType
  password        String
  contact         String   @unique
  address         String?
  aadharNumber    String?
  panNumber       String?
  hasOrganization Boolean  @default(false)
  createdAt       DateTime @default(now())

  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id], onUpdate: Cascade)
}

model organization {
  id              String   @id
  gstin           String   @unique
  orgName         String
  orgAddress      String
  fiscalYearStart String
  fiscalYearEnd   String
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())

  users users[]
}

enum UserType {
  FOUNDER
}
